<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.1</Version>
    <Authors>joshua88wa</Authors>
    <Company></Company>
    <Description>Reads which Blue Mage spells you have learned and builds the best 24-spell active set for the content you pick.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The built-in profiles ship inside the DLL. A copy in the plugin config folder,
         if one exists, is loaded instead, so players can edit their own. -->
    <None Remove="Profiles.json" />
    <EmbeddedResource Include="Profiles.json" LogicalName="BlueMageSetBuilder.Profiles.json" />

    <!-- Which creatures teach each spell. Generated by tools/make-sources.ps1. -->
    <None Remove="Sources.json" />
    <EmbeddedResource Include="Sources.json" LogicalName="BlueMageSetBuilder.Sources.json" />

    <!-- Spells each Masked Carnivale stage calls for, from Blue Academy. Generated by
         tools/make-carnivale.ps1. -->
    <None Remove="Carnivale.json" />
    <EmbeddedResource Include="Carnivale.json" LogicalName="BlueMageSetBuilder.Carnivale.json" />
    <EmbeddedResource Include="..\images\icon.png" LogicalName="BlueMageSetBuilder.icon.png" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="BlueMageSetBuilder.CHANGELOG.md" />
  </ItemGroup>
</Project>
